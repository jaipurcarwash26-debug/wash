            </a>
          </div>
        </div>

        <div class="col-md-6 col-lg-4">
          <div class="service-card">
            <div class="service-icon">
              <i class="bi bi-stars"></i>
            </div>

            <h4>Interior Cleaning</h4>

            <p>Keep your car interior clean, fresh and comfortable.</p>

            <a href="#plans">
              Learn More
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>

        <div class="col-md-6 col-lg-4">
          <div class="service-card">
            <div class="service-icon">
              <i class="bi bi-car-front"></i>
            </div>

            <h4>Full Car Clean</h4>

            <p>Complete exterior and interior cleaning for your vehicle.</p>

            <a href="#plans">
              Learn More
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

