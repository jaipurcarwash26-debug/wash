  <!-- =====================================
         HOW IT WORKS
    ====================================== -->

  <section class="section-padding">
    <div class="container">
      <div class="section-heading text-center">
        <span>HOW IT WORKS</span>

        <h2>
          Getting Started Is
          <span>Easy.</span>
        </h2>
      </div>

      <div class="row g-4">
        <div class="col-md-6 col-lg-3">
          <div class="step-card">
            <span>01</span>

            <i class="bi bi-person-plus"></i>

            <h4>Register</h4>

            <p>Register your details and your vehicle.</p>
          </div>
        </div>

        <div class="col-md-6 col-lg-3">
          <div class="step-card">
            <span>02</span>

            <i class="bi bi-card-checklist"></i>

            <h4>Choose Plan</h4>

            <p>Select the car cleaning plan that suits you.</p>
          </div>
        </div>

        <div class="col-md-6 col-lg-3">
          <div class="step-card">
            <span>03</span>

            <i class="bi bi-check-circle"></i>

            <h4>Get Confirmed</h4>

            <p>Our team reviews and confirms your request.</p>
          </div>
        </div>

        <div class="col-md-6 col-lg-3">
          <div class="step-card">
            <span>04</span>

            <i class="bi bi-stars"></i>

            <h4>Enjoy</h4>

            <p>Enjoy convenient regular car care.</p>
          </div>
        </div>
      </div>
    </div>
