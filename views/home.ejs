<body>
  <div class="scroll-progress"></div>
  <button class="back-to-top" aria-label="Back to top">
    <i class="bi bi-arrow-up"></i>
  </button>

  <!-- =====================================
         HERO SECTION
    ====================================== -->

  <section class="hero-section" id="home">
    <div class="container">
      <div class="row align-items-center min-vh-100">
        <div class="col-lg-6">
          <div class="hero-content">
            <div class="hero-badge">
              <i class="bi bi-stars"></i>
              Professional Car Care in Jaipur
            </div>

            <h1>
              Your Car Deserves
              <span>Better Care.</span>
            </h1>

            <p>
              Keep your car clean, fresh and shining with our convenient car
              cleaning subscription services.
            </p>

            <div class="hero-buttons">
              <a href="/trial/book" class="btn btn-primary-custom btn-lg">
                Book a Free Demo
                <i class="bi bi-arrow-right"></i>
              </a>

              <a
                href="/subscription/book"
                class="btn btn-outline-custom btn-lg"
              >
                Register For Subscription
              </a>
            </div>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="hero-image-wrapper">
            <div class="hero-circle"></div>

            <div class="hero-image-card">
              <div class="hero-car-placeholder">
                <span class="brand">
                  <img src="/images/car.png" alt="Jaipur Car Wash" />
                </span>

                <span>
                  JAIPUR
                  <br />
                  CAR WASH
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================
     CUSTOMER REVIEW VIDEO
====================================== -->

  <section class="review-video-section section-padding" id="reviewVideoSection">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-6">
          <div class="review-video-content">
            <span class="section-label">REAL CUSTOMER EXPERIENCE</span>

            <h2>
              Hear It From
              <span>Our Customers.</span>
            </h2>

            <p>
              See how Jaipur Car Clean makes everyday car care easier. Watch our
              customer review and discover the difference convenient, reliable
              service can make.
            </p>

            <div class="review-video-points">
              <div>
                <i class="bi bi-check-circle-fill"></i>
                Real customer experience
              </div>

              <div>
                <i class="bi bi-check-circle-fill"></i>
                Convenient car cleaning
              </div>

              <div>
                <i class="bi bi-check-circle-fill"></i>
                Reliable service in Jaipur
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-6">
          <div
            class="about-video-wrapper review-video-wrapper"
            id="reviewVideoPlayer"
          >
            <video
              id="reviewVideo"
              class="about-video"
              src="/videos/full.mp4"
              preload="metadata"
              playsinline
              webkit-playsinline
              controlslist="nodownload"
              aria-label="Jaipur Car Clean customer review video"
            >
              Your browser does not support HTML video.
            </video>

            <div class="about-video-overlay">
              <span class="about-video-brand">
                <i class="bi bi-chat-heart-fill"></i>
                CUSTOMER REVIEW
              </span>

              <div class="about-video-controls">
                <button
                  type="button"
                  id="reviewPlayPause"
                  class="about-video-btn"
                  aria-label="Play review video"
                  title="Play/Pause"
                >
                  <i class="bi bi-play-fill"></i>
                </button>

                <button
                  type="button"
                  id="reviewMuteToggle"
                  class="about-video-btn"
                  aria-label="Turn sound on"
                  title="Sound On/Off"
                >
                  <i class="bi bi-volume-mute-fill"></i>
                </button>

                <span id="reviewVideoStatus" class="about-video-status">
                  Ready to play
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================
         WHY CHOOSE US
    ====================================== -->

  <section class="section-padding">
    <div class="container">
      <div class="section-heading text-center">
        <span>WHY CHOOSE US</span>

        <h2>
          Car Care Made
          <span>Simple.</span>
        </h2>

        <p>Everything you need to keep your car looking its best.</p>
      </div>

      <div class="row g-4">
        <div class="col-md-6 col-lg-3">
          <div class="feature-card">
            <div class="feature-icon">
              <i class="bi bi-car-front"></i>
            </div>

            <h4>Professional Care</h4>

            <p>Quality car cleaning with attention to every detail.</p>
          </div>
        </div>

        <div class="col-md-6 col-lg-3">
          <div class="feature-card">
            <div class="feature-icon">
              <i class="bi bi-droplet"></i>
            </div>

            <h4>Quality Cleaning</h4>

            <p>Give your vehicle the clean and fresh finish it deserves.</p>
          </div>
        </div>

        <div class="col-md-6 col-lg-3">
          <div class="feature-card">
            <div class="feature-icon">
              <i class="bi bi-calendar-check"></i>
            </div>

            <h4>Easy Plans</h4>

            <p>Choose a monthly plan that fits your car care needs.</p>
          </div>
        </div>

        <div class="col-md-6 col-lg-3">
          <div class="feature-card">
            <div class="feature-icon">
              <i class="bi bi-wallet2"></i>
            </div>

            <h4>Affordable</h4>

            <p>Reliable car care without unnecessary expenses.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================
         ABOUT SECTION
    ====================================== -->

  <section class="about-section section-padding" id="about">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-6">
          <div class="about-video-wrapper" id="aboutVideoSection">
            <video
              id="aboutVideo"
              class="about-video"
              src="/videos/small.mp4"
              preload="metadata"
              playsinline
              webkit-playsinline
              controlslist="nodownload"
              aria-label="Jaipur Car Wash service video"
            >
              Your browser does not support HTML video.
            </video>

            <div class="about-video-overlay">
              <span class="about-video-brand">
                <i class="bi bi-stars"></i> JAIPUR CAR WASH
              </span>

              <div class="about-video-controls">
                <button
                  type="button"
                  id="aboutPlayPause"
                  class="about-video-btn"
                  aria-label="Play video"
                  title="Play/Pause"
                >
                  <i class="bi bi-play-fill"></i>
                </button>

                <button
                  type="button"
                  id="aboutMuteToggle"
                  class="about-video-btn"
                  aria-label="Turn sound on"
                  title="Sound On/Off"
                >
                  <i class="bi bi-volume-mute-fill"></i>
                </button>

                <span id="aboutVideoStatus" class="about-video-status">
                  Ready to play
                </span>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="about-content">
            <span class="section-label"> ABOUT US </span>

            <h2>
              More Than Just
              <span>A Car Clean.</span>
            </h2>

            <p>
              Jaipur Car Clean is built around one simple idea — keeping your
              car clean should be convenient, reliable and affordable.
            </p>

            <p>
              Our subscription-based services help you maintain your vehicle
              regularly without the hassle of arranging a car clean every time.
            </p>

            <div class="about-points">
              <div>
                <i class="bi bi-check-circle-fill"></i>
                Regular car care
              </div>

              <div>
                <i class="bi bi-check-circle-fill"></i>
                Convenient subscription plans
              </div>

              <div>
                <i class="bi bi-check-circle-fill"></i>
                Reliable service
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================
         SERVICES
    ====================================== -->

  <section class="section-padding" id="services">
